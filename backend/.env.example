# Copiar este archivo a .env y llenar con valores reales.
# .env NUNCA se sube al repositorio (ya está en .gitignore).

DATABASE_URL=postgresql://prepia_user:prepia_pass@localhost:5432/prepia_db

JWT_SECRET_KEY=cambia_esta_clave_secreta_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

CODE_EXECUTION_API_URL=https://judge0-ce.p.rapidapi.com
CODE_EXECUTION_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

# Configuración de IA para análisis de Hojas de Vida (por defecto $0 / local)
# Opciones: local | ollama | groq | gemini | openai | anthropic
AI_PROVIDER=local
AI_ALLOW_EXTERNAL=false

# Opción 100% gratis en tu equipo (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Opción capa gratuita sin tarjeta (Groq Free Tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Opción capa gratuita Google AI Studio (sin facturación)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Proveedores adicionales opcionales
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
